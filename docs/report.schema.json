{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unveil report v1",
  "type": "object",
  "required": ["schemaVersion", "tool", "input", "mode", "status", "metadata", "findings", "diagnostics", "transformations", "output"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "tool": {
      "type": "object", "required": ["name", "version"],
      "properties": {"name": {"const": "Unveil"}, "version": {"type": "string"}}
    },
    "input": {
      "type": "object", "required": ["path", "type", "sha256", "size"],
      "properties": {
        "path": {"type": "string"}, "type": {"enum": ["JAR", "CLASS", "PE"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 0}
      }
    },
    "mode": {"enum": ["inspect", "analyze", "plan", "deobfuscate", "unpack", "verify", "diff"]},
    "status": {"enum": ["completed", "partial", "blocked", "failed", "completed_with_unresolved"]},
    "metadata": {"type": "object"},
    "findings": {
      "type": "array", "items": {
        "type": "object", "required": ["id", "severity", "confidence", "evidence", "locations"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 100},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "locations": {"type": "array"}
        }
      }
    },
    "diagnostics": {"type": "array", "items": {"type": "object"}},
    "transformations": {
      "type": "array", "items": {
        "type": "object", "required": ["id", "status", "candidates", "changed", "failed", "skipped"],
        "properties": {
          "id": {"type": "string"}, "status": {"type": "string"},
          "candidates": {"type": "integer", "minimum": 0},
          "changed": {"type": "integer", "minimum": 0},
          "failed": {"type": "integer", "minimum": 0},
          "skipped": {"type": "integer", "minimum": 0}
        }
      }
    },
    "output": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "required": ["path", "sha256", "verified"],
          "properties": {
            "path": {"type": "string"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "verified": {"type": "boolean"}
          }
        }
      ]
    }
  }
}
